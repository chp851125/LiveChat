@model LiveChat.ViewModels.ChannelViewModel
@{
    ViewData["Title"] = Model.Title;
}

<a asp-action="Index">&larr; 回頻道清單</a>

<div class="d-flex flex-wrap align-items-center gap-2 my-3">
    <h1 class="h3 mb-0 text-break">@Model.Title</h1>
    <partial name="_ChannelBadges" model="Model.Channel" />
</div>

@if (Model.Channel.Type != ChannelType.Direct)
{
    <div class="d-flex flex-wrap gap-2 mb-3">
        <a class="btn btn-outline-secondary" asp-action="Members" asp-route-id="@Model.Channel.Id">
            @(Model.CanManageMembers ? "管理成員" : "成員")（@Model.Members.Count）
        </a>
        @if (Model.Channel.Type == ChannelType.Public && !Model.Channel.IsArchived)
        {
            if (Model.IsMember)
            {
                <form asp-action="Leave" asp-route-id="@Model.Channel.Id" method="post">
                    <button type="submit" class="btn btn-outline-danger">離開頻道</button>
                </form>
            }
            else
            {
                <form asp-action="Join" asp-route-id="@Model.Channel.Id" method="post">
                    <button type="submit" class="btn btn-primary">加入頻道</button>
                </form>
            }
        }
    </div>
}

@if (Model.IsMember)
{
    <p class="text-muted">訊息功能尚未開放。</p>
}
else if (Model.Channel.IsArchived)
{
    <p class="text-muted">你不是成員，看不到訊息內容；頻道已封存，無法加入。</p>
}
else
{
    <p class="text-muted">加入頻道後才能看到訊息內容。</p>
}
