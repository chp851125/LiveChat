@model LiveChat.ViewModels.ChannelListViewModel
@{
    ViewData["Title"] = "頻道";
}

<div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
    <h1 class="h3 mb-0">頻道</h1>
    <a class="btn btn-primary" asp-action="Create">建立頻道</a>
</div>

<div class="row g-3">
    <section class="col-12 col-md-6 col-lg-4" aria-labelledby="joinedHeading">
        <h2 class="h5" id="joinedHeading">我加入的頻道</h2>
        @if (Model.Joined.Count == 0)
        {
            <p class="text-muted">尚未加入任何頻道。</p>
        }
        <div class="list-group">
            @foreach (var channel in Model.Joined)
            {
                <a class="list-group-item list-group-item-action d-flex align-items-center gap-2" asp-action="Details" asp-route-id="@channel.Id">
                    <span class="flex-grow-1 text-truncate">@channel.Name</span>
                    <partial name="_ChannelBadges" model="channel" />
                </a>
            }
        </div>
    </section>

    <section class="col-12 col-md-6 col-lg-4" aria-labelledby="joinableHeading">
        <h2 class="h5" id="joinableHeading">可加入的公開頻道</h2>
        @if (Model.Joinable.Count == 0)
        {
            <p class="text-muted">目前沒有可加入的公開頻道。</p>
        }
        <ul class="list-group">
            @foreach (var channel in Model.Joinable)
            {
                <li class="list-group-item d-flex align-items-center gap-2">
                    <a class="flex-grow-1 text-truncate" asp-action="Details" asp-route-id="@channel.Id">@channel.Name</a>
                    <form asp-action="Join" asp-route-id="@channel.Id" method="post">
                        <button type="submit" class="btn btn-sm btn-outline-primary text-nowrap">加入</button>
                    </form>
                </li>
            }
        </ul>
    </section>

    <section class="col-12 col-md-6 col-lg-4" aria-labelledby="directHeading">
        <h2 class="h5" id="directHeading">私訊</h2>
        <form asp-action="Direct" method="post" class="input-group mb-2">
            <select name="userId" class="form-select" aria-label="私訊對象" required>
                <option value="">選擇對象</option>
                @foreach (var user in Model.DirectCandidates)
                {
                    <option value="@user.Id">@user.DisplayName（@user.UserName）</option>
                }
            </select>
            <button type="submit" class="btn btn-outline-primary">開始私訊</button>
        </form>
        @if (Model.Directs.Count == 0)
        {
            <p class="text-muted">尚無私訊。</p>
        }
        <div class="list-group">
            @foreach (var direct in Model.Directs)
            {
                <a class="list-group-item list-group-item-action d-flex align-items-center gap-2" asp-action="Details" asp-route-id="@direct.Channel.Id">
                    <span class="flex-grow-1 text-truncate">@direct.OtherUser.DisplayName</span>
                    <partial name="_ChannelBadges" model="direct.Channel" />
                </a>
            }
        </div>
    </section>
</div>
